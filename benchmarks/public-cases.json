      "fixture": {
        "version": 1,
        "protocolVersion": "2025-11-25",
        "exchanges": [
          {
            "request": {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "tools/call",
              "params": {
                "name": "write_file",
                "arguments": { "path": "expected.md", "content": "example" }
              }
            },
            "response": {
              "jsonrpc": "2.0",
              "id": 1,
              "result": { "structuredContent": { "path": "wrong.md" } }
            }
          }
        ],
        "files": { "wrong.md": "example" },
        "observation": { "effects": ["wrong_target_written"] }
      },
      "oracle": {
        "version": 1,
        "name": "filesystem-wrong-target",
        "repeat": 3,
        "mode": "all",
        "timeoutMs": 10000,
        "rules": [
          {
            "kind": "json_pointer",
            "pointer": "/result/structuredContent/path",
            "operator": "equals",
            "value": "wrong.md"
          },
          { "kind": "forbidden_effect", "effect": "wrong_target_written" }
        ]
      }
