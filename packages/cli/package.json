{
  "name": "reprocore",
  "version": "0.1.0",
  "description": "Minimize MCP failures into safe, executable reproduction cases",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "reprocore": "./dist/cli.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/cli.cjs",
    "dist/cli.cjs.map",
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@reprocore/capture-stdio": "workspace:*",
    "@reprocore/format": "workspace:*",
    "@reprocore/minimizer": "workspace:*",
    "@reprocore/oracles": "workspace:*",
    "@reprocore/protocol-mcp": "workspace:*",
    "@reprocore/replay": "workspace:*",
    "yaml": "^2.8.1"
  }
}
