{
  "version": 1,
  "protocolVersion": "2026-07-28",
  "exchanges": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": "discover",
        "method": "server/discover",
        "params": { "_meta": { "protocolVersion": "2026-07-28" } }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": "discover",
        "result": {
          "tools": [
            {
              "name": "write_file",
              "inputSchema": {
                "type": "object",
                "properties": { "target": { "type": "object" } }
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": "write",
        "method": "tools/call",
        "params": {
          "name": "write_file",
          "arguments": { "target": { "path": "wrong.md" } }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": "write",
        "result": { "structuredContent": { "path": "wrong.md" } }
      }
    }
  ],
  "files": { "fixtures/report.md": "wrong content" },
  "observation": { "exitCode": 0, "effects": ["wrong_target_written"] }
}
